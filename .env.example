# Defaults work without secrets or any external AI service.
PORT=3000
MONEY_GRAPH_STORAGE=./var/runs

# Optional AI; never needed for the pipeline, reports or the graph.
# Set ONE of these. The app does not load .env automatically.
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
# Set a private access code when exposing the paid assistant on a public server.
MONEY_GRAPH_ASSISTANT_TOKEN=
